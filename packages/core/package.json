{
  "name": "@markstage/core",
  "version": "0.4.0",
  "description": "Markstage core: Markdown <-> editor document with block packs, surgical saves, frontmatter.",
  "keywords": [
    "markstage",
    "markdown",
    "mdx",
    "cms",
    "content",
    "frontmatter",
    "remark",
    "tiptap"
  ],
  "homepage": "https://github.com/spcaeo/markstage/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/spcaeo/markstage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spcaeo/markstage.git",
    "directory": "packages/core"
  },
  "license": "Elastic-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./verify": {
      "types": "./src/verify.d.ts",
      "default": "./src/verify.mjs"
    },
    "./site-config": "./src/site-config.mjs",
    "./authors": "./src/authors.mjs",
    "./page-types": "./src/page-types.mjs",
    "./topics": "./src/topics.mjs",
    "./link-map": "./src/link-map.mjs",
    "./link-suggest": "./src/link-suggest.mjs",
    "./links": "./src/links.mjs",
    "./locks": {
      "types": "./src/locks.d.ts",
      "default": "./src/locks.mjs"
    },
    "./csp": {
      "types": "./src/csp.d.ts",
      "default": "./src/csp.mjs"
    },
    "./json": "./src/json/index.mjs",
    "./json/keystatic": "./src/json/adapters/keystatic.mjs",
    "./release": {
      "types": "./src/release.d.ts",
      "default": "./src/release.mjs"
    }
  },
  "files": [
    "src/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "decode-named-character-reference": "^1.3.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  }
}
