{
  "name": "@markstage/astro",
  "version": "0.4.0",
  "description": "Markstage for Astro: the editor in `astro dev` (no sign-in, 127.0.0.1 only), its production build for a Markstage server (markstage build-editor) and the site config loader.",
  "keywords": [
    "markstage",
    "astro",
    "astro-integration",
    "withastro",
    "cms",
    "markdown",
    "mdx",
    "editor",
    "git-based-cms"
  ],
  "homepage": "https://github.com/spcaeo/markstage/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/spcaeo/markstage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spcaeo/markstage.git",
    "directory": "packages/astro"
  },
  "license": "Elastic-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./config": "./src/config.mjs",
    "./bind": {
      "types": "./src/bind.d.ts",
      "default": "./src/bind.mjs"
    },
    "./authors": {
      "types": "./src/authors.d.ts",
      "default": "./src/authors.mjs"
    },
    "./pages": {
      "types": "./src/pages.d.ts",
      "default": "./src/pages.mjs"
    },
    "./topics": {
      "types": "./src/topics.d.ts",
      "default": "./src/topics.mjs"
    },
    "./page.astro": "./src/page.astro"
  },
  "bin": {
    "markstage": "bin/markstage.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@markstage/core": "0.4.0",
    "@markstage/editor": "0.4.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "astro": "^7.4.4"
  }
}
