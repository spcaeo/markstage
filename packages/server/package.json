{
  "name": "@markstage/server",
  "version": "0.4.0",
  "description": "Markstage production server: sign-in, roles, content API, publish jobs, revisions, media, audit log.",
  "keywords": [
    "markstage",
    "cms",
    "server",
    "git-based-cms",
    "headless-cms",
    "markdown",
    "astro",
    "self-hosted"
  ],
  "homepage": "https://github.com/spcaeo/markstage/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/spcaeo/markstage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spcaeo/markstage.git",
    "directory": "packages/server"
  },
  "license": "Elastic-2.0",
  "type": "module",
  "main": "./src/app.mjs",
  "exports": {
    ".": "./src/app.mjs"
  },
  "bin": {
    "markstage-server": "bin/markstage-server.mjs",
    "markstage-deploy": "bin/markstage-deploy.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node bin/markstage-server.mjs serve",
    "test": "npm run -s test:unit && npm run -s test:e2e",
    "test:unit": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@markstage/core": "0.4.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
