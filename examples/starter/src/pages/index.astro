---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { byDate, isLive, longDate } from '../lib/live';

const posts = (await getCollection('posts', isLive)).sort(byDate);
const guides = (await getCollection('guides', isLive)).sort(byDate);
const cards = [
  { title: 'Posts', base: '/posts/', items: posts },
  { title: 'Guides', base: '/guides/', items: guides },
].filter((s) => s.items.length);
---
<Base title="My blog">
  <section class="intro">
    <h1>My blog</h1>
    <p>Notes, guides and stories, written on the page.</p>
  </section>
  {cards.map((s) => (
    <section class="group" aria-labelledby={`h-${s.title.toLowerCase()}`}>
      <h2 class="group__title" id={`h-${s.title.toLowerCase()}`}>{s.title}</h2>
      <ul class="cards">
        {s.items.map((p) => (
          <li class="card">
            <a href={`${s.base}${p.id}/`}>
              <time datetime={p.data.date.toISOString().slice(0, 10)}>{longDate(p.data.date)}</time>
              <h3>{p.data.title}</h3>
              {p.data.description && <p>{p.data.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
