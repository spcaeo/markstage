{
  "name": "markstage-monorepo",
  "private": true,
  "type": "module",
  "license": "Elastic-2.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p packages/editor --noEmit",
    "lines": "node scripts/check-lines.mjs",
    "generic": "node scripts/check-generic.mjs && node scripts/check-licence.mjs",
    "licence": "node scripts/check-licence.mjs",
    "guide": "node --experimental-strip-types --no-warnings scripts/writer-guide.mjs",
    "release": "node scripts/release.mjs",
    "create-site": "node scripts/create-site.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "prepare": "node -e \"fs.existsSync('scripts/hooks/install.mjs') && import('./scripts/hooks/install.mjs')\"",
    "secrets:scan": "node scripts/hooks/secret-scan.mjs --staged",
    "public:sync": "node scripts/public-sync.mjs",
    "site:build": "node scripts/site/build-site.mjs",
    "site:check": "node scripts/site/build-site.mjs --check",
    "site:test": "node --test \"scripts/site/*.test.mjs\" scripts/lib/licence-words.test.mjs",
    "site:og": "node scripts/site/render-social.mjs",
    "site:brand": "node scripts/site/render-brand.mjs",
    "site:shots": "node scripts/site/capture-shots.mjs",
    "demo:build": "node scripts/demo/build-demo.mjs",
    "demo:record": "node scripts/demo/record.mjs",
    "demo:video": "node scripts/demo/record-video.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "version": "0.3.0"
}
